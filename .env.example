# Copy to .env and edit. Every value is optional. Never commit .env.
# Secrets here are read by the BACKEND only and are never sent to the browser.

# --- server -------------------------------------------------------------
# GHOST_HOST=127.0.0.1          # keep on loopback; there is no login
# GHOST_PORT=8787
# GHOST_DATA_DIR=./data         # SQLite DB, vault, uploads, reports, backups
# GHOST_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- evidence vault -----------------------------------------------------
# Set to encrypt NEWLY registered evidence at rest (AES-256-GCM, scrypt-derived key).
# Losing this passphrase makes encrypted evidence unrecoverable.
# GHOST_VAULT_PASSPHRASE=
# GHOST_MAX_UPLOAD_MB=200

# --- threat-intelligence providers (enrichment) --------------------------
# VIRUSTOTAL_API_KEY=
# ABUSEIPDB_API_KEY=
# IPINFO_TOKEN=                 # also provides the coordinates plotted on the map

# --- optional AI analyst (any OpenAI-compatible endpoint, e.g. local Ollama) ---
# GHOST_AI_BASE_URL=http://localhost:11434/v1
# GHOST_AI_MODEL=llama3.1
# GHOST_AI_API_KEY=

# --- optional tools -----------------------------------------------------
# GHOST_TSHARK_PATH=C:\Program Files\Wireshark\tshark.exe
# GHOST_ZEEK_PATH=
# GHOST_PCAP_TIMEOUT=120

# --- DNS / networking ---------------------------------------------------
# GHOST_DNS_SERVER=1.1.1.1      # default: the machine's configured resolver
# GHOST_HTTP_TIMEOUT=8
# Lab-only escape hatch that disables private-address protection. Leave OFF.
# GHOST_ALLOW_PRIVATE_TARGETS=0

# --- map ----------------------------------------------------------------
# Default: OpenStreetMap standard tiles (light, darkened client-side). OSM's tile usage
# policy applies — fine for a personal workstation; use your own provider for heavy use.
# GHOST_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# GHOST_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
# GHOST_MAP_DARK_TILES=0        # set 1 if your provider already serves a dark style
